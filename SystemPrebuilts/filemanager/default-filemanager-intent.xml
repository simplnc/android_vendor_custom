<?xml version="1.0" encoding="utf-8"?>
<!--
  Default intent handler configuration for Fossify File Manager
  This ensures the file manager app handles all file browsing and management intents
-->
<config>
    <default-intent-filter-actions>
        <!-- File browsing intents -->
        <action name="android.intent.action.VIEW">
            <data android:mimeType="resource/folder" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- Document picker intents -->
        <action name="android.intent.action.OPEN_DOCUMENT">
            <data android:mimeType="*/*" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- Document tree picker -->
        <action name="android.intent.action.OPEN_DOCUMENT_TREE">
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- Create document intents -->
        <action name="android.intent.action.CREATE_DOCUMENT">
            <data android:mimeType="*/*" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- File manager main intent -->
        <action name="android.intent.action.MAIN">
            <category android:name="android.intent.category.APP_FILES" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- File picker intents -->
        <action name="android.intent.action.PICK">
            <data android:mimeType="*/*" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- Get content intents for files -->
        <action name="android.intent.action.GET_CONTENT">
            <data android:mimeType="*/*" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- Archive file viewing -->
        <action name="android.intent.action.VIEW">
            <data android:mimeType="application/zip" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <action name="android.intent.action.VIEW">
            <data android:mimeType="application/x-rar-compressed" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <action name="android.intent.action.VIEW">
            <data android:mimeType="application/x-tar" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- APK file handling with user permission prompts -->
        <action name="android.intent.action.VIEW">
            <data android:mimeType="application/vnd.android.package-archive" />
            <package android:name="org.fossify.filemanager" />
        </action>
        
        <!-- Document management -->
        <action name="android.provider.action.MANAGE_ROOT">
            <package android:name="org.fossify.filemanager" />
        </action>
    </default-intent-filter-actions>
</config> 