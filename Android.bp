// ============================================================================
// SYSTEMBUILT APPLICATIONS (Privileged apps) - All APKs are in SystemPrebuilts
// ============================================================================

// Gallery Applications
android_app_import {
    name: "org.fossify.gallery",
    apk: "SystemPrebuilts/gallery/org.fossify.gallery.apk",
    preprocessed: false,     // Contains compressed DEX files
    certificate: "platform", // Use platform certificate for non-preprocessed APK
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
    overrides: [
        "Gallery",           // AOSP default gallery
        "Gallery2",          // Alternative gallery
        "GalleryGo",         // Gallery Go
        "Photos",            // Google Photos
        "LineageGallery",    // LineageOS gallery
        "LineageGallery2",   // LineageOS gallery 2
        "OmniGallery",       // OmniROM gallery
        "com.android.gallery", // AOSP gallery package
        "com.android.gallery3d", // AOSP gallery 3D package
        "com.google.android.apps.photos", // Google Photos package
        "org.lineageos.gallery", // LineageOS gallery package
        "org.lineageos.gallery2", // LineageOS gallery 2 package
        "Glimpse",           // LineageOS Glimpse gallery
        "com.lineageos.glimpse", // LineageOS Glimpse package
    ],
}

