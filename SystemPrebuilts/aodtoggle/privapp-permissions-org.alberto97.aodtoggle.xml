<!-- Privileged permissions for org.alberto97.aodtoggle -->
<permissions>
    <privapp-permissions package="org.alberto97.aodtoggle">
        <!-- Core permission for modifying secure system settings -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        
        <!-- System UI integration for quick settings tile -->
        <permission name="android.permission.STATUS_BAR"/>
        <permission name="android.permission.EXPAND_STATUS_BAR"/>
        
        <!-- Boot permission to restore tile state after reboot -->
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED"/>
        
        <!-- System settings access for reading current AOD state -->
        <permission name="android.permission.WRITE_SETTINGS"/>
        
        <!-- Query all packages to check for system features -->
        <permission name="android.permission.QUERY_ALL_PACKAGES"/>
        
        <!-- Optional: Wake lock to ensure operations complete -->
        <permission name="android.permission.WAKE_LOCK"/>
        
        <!-- System alert window for potential overlay features -->
        <permission name="android.permission.SYSTEM_ALERT_WINDOW"/>
        
        <!-- Device admin capabilities if needed for AOD control -->
        <permission name="android.permission.BIND_DEVICE_ADMIN"/>
        
        <!-- Notification permissions for status updates -->
        <permission name="android.permission.POST_NOTIFICATIONS"/>
    </privapp-permissions>
</permissions> 