<!-- Privileged permissions for org.fossify.filemanager -->
<permissions>
    <privapp-permissions package="org.fossify.filemanager">
        <!-- Core File Manager Permissions -->
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
        <permission name="android.permission.READ_EXTERNAL_STORAGE"/>
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE"/>
        
        <!-- System Integration Permissions -->
        <permission name="android.permission.POST_NOTIFICATIONS"/>
        <permission name="android.permission.USE_FINGERPRINT"/>
        <permission name="android.permission.USE_BIOMETRIC"/>
        
        <!-- Custom Fossify Permission -->
        <permission name="org.fossify.android.permission.WRITE_GLOBAL_SETTINGS"/>
        
        <!-- Additional File Manager Permissions -->
        <permission name="android.permission.MANAGE_DOCUMENTS"/>
        <permission name="android.permission.ACCESS_ALL_EXTERNAL_STORAGE"/>
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="android.permission.MANAGE_MEDIA"/>
        
        <!-- Media File Access Permissions -->
        <permission name="android.permission.READ_MEDIA_IMAGES"/>
        <permission name="android.permission.READ_MEDIA_VIDEO"/>
        <permission name="android.permission.READ_MEDIA_AUDIO"/>
        <permission name="android.permission.ACCESS_MEDIA_LOCATION"/>
        
        <!-- Archive and Compression -->
        <permission name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
        
        <!-- System File Operations -->
        <permission name="android.permission.WRITE_SETTINGS"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"/>
        <permission name="android.permission.MOUNT_FORMAT_FILESYSTEMS"/>
        
        <!-- Package Management - User Prompted Permissions -->
        <!-- These permissions require user approval and are not auto-granted -->
        <!-- android.permission.REQUEST_INSTALL_PACKAGES - User will be prompted -->
        <!-- android.permission.INSTALL_PACKAGES - Not auto-granted, requires user consent -->
        <!-- android.permission.DELETE_PACKAGES - Not auto-granted, requires user consent -->
        <!-- android.permission.REQUEST_DELETE_PACKAGES - User will be prompted -->
        <permission name="android.permission.QUERY_ALL_PACKAGES"/>
        
        <!-- System Operations -->
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED"/>
        <permission name="android.permission.WAKE_LOCK"/>
        <permission name="android.permission.FOREGROUND_SERVICE"/>
        <permission name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
        
        <!-- Root and System Access -->
        <permission name="android.permission.ACCESS_SUPERUSER"/>
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        
        <!-- Network Access - User Prompted Permissions -->
        <!-- These permissions require user approval and are not auto-granted -->
        <!-- android.permission.INTERNET - User will be prompted for network access -->
        <!-- android.permission.ACCESS_NETWORK_STATE - User will be prompted -->
        <!-- android.permission.ACCESS_WIFI_STATE - User will be prompted -->
        
        <!-- Device Hardware Access -->
        <permission name="android.permission.VIBRATE"/>
        <permission name="android.permission.FLASHLIGHT"/>
        
        <!-- Advanced File Operations -->
        <permission name="android.permission.SET_WALLPAPER"/>
        <permission name="android.permission.SET_WALLPAPER_HINTS"/>
        <permission name="android.permission.MODIFY_AUDIO_SETTINGS"/>
        
        <!-- OBB File Management -->
        <permission name="android.permission.WRITE_OBB"/>
        
        <!-- System UI Integration -->
        <permission name="android.permission.STATUS_BAR"/>
        <permission name="android.permission.EXPAND_STATUS_BAR"/>
        
        <!-- USB and External Storage -->
        <permission name="android.permission.HARDWARE_TEST"/>
        <permission name="android.permission.USB_PERMISSION"/>
        
        <!-- Backup and Restore -->
        <permission name="android.permission.BACKUP"/>
        <permission name="android.permission.CONFIRM_FULL_BACKUP"/>
        
        <!-- System Process Management -->
        <permission name="android.permission.KILL_BACKGROUND_PROCESSES"/>
        <permission name="android.permission.RESTART_PACKAGES"/>
        
        <!-- Advanced System Access -->
        <permission name="android.permission.WRITE_GSERVICES"/>
        <permission name="android.permission.READ_LOGS"/>
        <permission name="android.permission.DUMP"/>
    </privapp-permissions>
</permissions> 