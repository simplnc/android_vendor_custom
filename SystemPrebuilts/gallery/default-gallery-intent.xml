<?xml version="1.0" encoding="utf-8"?>
<!--
  Default intent handler configuration for Fossify Gallery
  This ensures the gallery app handles all media viewing intents
-->
<config>
    <default-intent-filter-actions>
        <!-- Image viewing intents -->
        <action name="android.intent.action.VIEW">
            <data android:mimeType="image/*" />
            <package android:name="org.fossify.gallery" />
        </action>
        
        <!-- Video viewing intents -->
        <action name="android.intent.action.VIEW">
            <data android:mimeType="video/*" />
            <package android:name="org.fossify.gallery" />
        </action>
        
        <!-- Gallery browsing intents -->
        <action name="android.intent.action.MAIN">
            <category android:name="android.intent.category.APP_GALLERY" />
            <package android:name="org.fossify.gallery" />
        </action>
        
        <!-- Media picker intents -->
        <action name="android.intent.action.PICK">
            <data android:mimeType="image/*" />
            <package android:name="org.fossify.gallery" />
        </action>
        
        <action name="android.intent.action.PICK">
            <data android:mimeType="video/*" />
            <package android:name="org.fossify.gallery" />
        </action>
        
        <!-- Get content intents -->
        <action name="android.intent.action.GET_CONTENT">
            <data android:mimeType="image/*" />
            <package android:name="org.fossify.gallery" />
        </action>
        
        <action name="android.intent.action.GET_CONTENT">
            <data android:mimeType="video/*" />
            <package android:name="org.fossify.gallery" />
        </action>
    </default-intent-filter-actions>
</config> 