<!-- Default configuration for Always On Display Toggle -->
<config>
    <!-- Pre-approve the quick settings tile service -->
    <allow-in-power-save-except-idle package="org.alberto97.aodtoggle" />
    <allow-in-data-usage-save package="org.alberto97.aodtoggle" />
    
    <!-- System app configuration -->
    <system-user-whitelisted-app package="org.alberto97.aodtoggle" />
    
    <!-- Allow background activity for quick settings functionality -->
    <allow-unthrottled-location package="org.alberto97.aodtoggle" />
    
    <!-- Grant system-level privileges -->
    <privileged-app package="org.alberto97.aodtoggle" />
    
    <!-- Quick settings tile service registration -->
    <hidden-api-whitelisted-app package="org.alberto97.aodtoggle" />
    
    <!-- System UI integration -->
    <default-enabled-vr-app package="org.alberto97.aodtoggle" class=".MainService" />
</config> 